SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

DEFAULT_CLINIC_ID=10000000-0000-4000-8000-000000000001

RAG_MATCH_COUNT=3
RAG_MATCH_THRESHOLD=0.60
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

AVAILABILITY_SLOT_INTERVAL_MINUTES=15
GENERIC_AVAILABILITY_MINUTES=30
AVAILABILITY_SEARCH_DAYS=30

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10

# Comma-separated dashboard origins allowed to call FastAPI.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000
# Public dashboard origin used only as the destination for Auth emails.
DASHBOARD_APPLICATION_URL=http://localhost:3000

# Public recruiter demo. Keep disabled until the quota migration is applied.
DEMO_ENABLED=false
DEMO_API_TOKEN=replace-with-at-least-32-random-characters
DEMO_QUERY_LIMIT=10
DEMO_QUERY_WINDOW_SECONDS=3600
